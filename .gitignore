/.phpunit.cache
/node_modules
# public/build is committed: the production host runs an old glibc and cannot
# run Vite/Rollup's native binary, so assets are built locally and shipped.
/public/hot
/public/storage
/storage/*.key
/storage/pail
/vendor
.env
.env.backup
.env.production
.phpactor.json
.phpunit.result.cache
Homestead.json
Homestead.yaml
npm-debug.log
yarn-error.log
/auth.json
/.fleet
/.idea
/.nova
/.vscode
/.zed
/.playwright-mcp
/.worktrees
.cloudflared-tunnel.yaml

# Livewire publishes JS assets here. Tracking them causes drift bugs whenever
# the composer-installed Livewire version moves ahead — the browser ends up
# running stale JS against newer server PHP. Let Livewire's controller serve
# the matching version via /livewire/livewire.js instead.
/public/vendor/livewire

# Root-level spreadsheet/data exports (keep fixtures in tests/Fixtures/)
/*.xlsx
/*.xls
/*.csv
# Pest browser-test screenshots (regenerated per run)
/tests/Browser/Screenshots

# Local DB dumps / backups (never commit — contains production data)
*.sql.gz
*.sql
